{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pybricks: run current file on hub",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pybricksdev", "run", "ble", "${file}"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Pybricks: run current file on named hub",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pybricksdev", "run", "ble", "--name", "${input:hubName}", "${file}"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    }
  ],
  "inputs": [
    {
      "id": "hubName",
      "type": "promptString",
      "description": "Exact hub name chosen during firmware installation",
      "default": "Team 01"
    }
  ]
}
